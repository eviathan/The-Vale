<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StardewTools.SaveEditor.ViewModels"
        xmlns:controls="using:StardewTools.SaveEditor.Controls"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:iconconv="using:StardewTools.SaveEditor.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="720"
        x:Class="StardewTools.SaveEditor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="StardewTools"
        Width="1680" Height="1000" MinWidth="820" MinHeight="600" WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="StackPanel.field">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="8"/>
        </Style>
        <Style Selector="StackPanel.field &gt; TextBlock">
            <Setter Property="Width" Value="120"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="StackPanel.field &gt; NumericUpDown">
            <Setter Property="Width" Value="180"/>
            <Setter Property="FormatString" Value="0"/>
        </Style>

        <Style Selector="Border.invSlot">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Border.invSlot.locked">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style Selector="Border.invSlot.selected">
            <Setter Property="BorderBrush" Value="#4FC3F7"/>
        </Style>
    </Window.Styles>

    <Window.Resources>
        <!-- Shared by every Collections sub-tab (Shipping/Minerals/Cooking) - one
             CollectionSectionViewModel instance per tab, see MainWindow.axaml.cs for the
             generic (section-agnostic) double-click handlers. -->
        <DataTemplate x:Key="CollectionSectionTemplate" x:DataType="vm:CollectionSectionViewModel">
            <Grid Margin="0,10,0,0" RowDefinitions="Auto,Auto,*,Auto,Auto,*" ColumnDefinitions="*" MaxWidth="420" HorizontalAlignment="Left">
                <TextBlock Grid.Row="0" Text="Not collected" FontWeight="Bold"/>
                <TextBox Grid.Row="1" Text="{Binding SearchText}" Watermark="Search..." Margin="0,4,0,4"/>
                <ListBox Grid.Row="2" ItemsSource="{Binding Available}"
                         SelectionMode="Multiple" SelectedItems="{Binding SelectedAvailableItems}"
                         DoubleTapped="OnCollectionAvailableDoubleTapped"/>
                <TextBlock Grid.Row="3" Text="{Binding Collected.Count, StringFormat='Collected ({0}) - double-click, or select (shift/ctrl/cmd-click, cmd-A for all) + Add/Remove'}"
                           FontWeight="Bold" Margin="0,10,0,4" TextWrapping="Wrap"/>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                    <Button Content="Add ->" Command="{Binding AddCommand}"/>
                    <Button Content="&lt;- Remove" Command="{Binding RemoveCommand}"/>
                </StackPanel>
                <ListBox Grid.Row="5" ItemsSource="{Binding Collected}"
                         SelectionMode="Multiple" SelectedItems="{Binding SelectedCollectedItems}"
                         DoubleTapped="OnCollectionCollectedDoubleTapped"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <TabControl>
        <TabItem Header="Save File">
            <DockPanel Margin="16" DataContext="{Binding SaveEditor}" x:DataType="vm:SaveEditorViewModel">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                    <Button Content="Open Save..." Click="OnOpenClicked"/>
                    <Button Content="Save" Click="OnSaveClicked" IsEnabled="{Binding IsSaveLoaded}"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Margin="0,12,0,0" Opacity="0.7"/>

                <TabControl IsEnabled="{Binding IsSaveLoaded}">

                    <TabItem Header="Player">
                        <ScrollViewer DataContext="{Binding Player}" x:DataType="vm:PlayerTabViewModel">
                            <StackPanel Spacing="10" Margin="0,10,0,0">
                                <StackPanel Classes="field">
                                    <TextBlock Text="Name"/>
                                    <TextBox Text="{Binding PlayerName}" Width="180"/>
                                </StackPanel>
                                <StackPanel Classes="field">
                                    <TextBlock Text="Money"/>
                                    <NumericUpDown Value="{Binding Money}" Minimum="0" Maximum="999999999"/>
                                </StackPanel>
                                <StackPanel Classes="field">
                                    <TextBlock Text="Health"/>
                                    <NumericUpDown Value="{Binding Health}" Minimum="0" Maximum="9999"/>
                                </StackPanel>
                                <StackPanel Classes="field">
                                    <TextBlock Text="Max Health"/>
                                    <NumericUpDown Value="{Binding MaxHealth}" Minimum="0" Maximum="9999"/>
                                </StackPanel>
                                <StackPanel Classes="field">
                                    <TextBlock Text="Stamina"/>
                                    <NumericUpDown Value="{Binding Stamina}" Minimum="0" Maximum="9999"/>
                                </StackPanel>
                                <StackPanel Classes="field">
                                    <TextBlock Text="Season"/>
                                    <TextBox Text="{Binding Season}" Width="180"/>
                                </StackPanel>
                                <StackPanel Classes="field">
                                    <TextBlock Text="Day"/>
                                    <NumericUpDown Value="{Binding DayOfMonth}" Minimum="1" Maximum="28"/>
                                </StackPanel>
                                <StackPanel Classes="field">
                                    <TextBlock Text="Year"/>
                                    <NumericUpDown Value="{Binding Year}" Minimum="1" Maximum="9999"/>
                                </StackPanel>
                                <TextBlock Text="Skills" FontWeight="Bold" Margin="0,12,0,0"/>
                                <StackPanel Classes="field"><TextBlock Text="Farming"/><NumericUpDown Value="{Binding FarmingLevel}" Minimum="0" Maximum="10"/></StackPanel>
                                <StackPanel Classes="field"><TextBlock Text="Fishing"/><NumericUpDown Value="{Binding FishingLevel}" Minimum="0" Maximum="10"/></StackPanel>
                                <StackPanel Classes="field"><TextBlock Text="Foraging"/><NumericUpDown Value="{Binding ForagingLevel}" Minimum="0" Maximum="10"/></StackPanel>
                                <StackPanel Classes="field"><TextBlock Text="Mining"/><NumericUpDown Value="{Binding MiningLevel}" Minimum="0" Maximum="10"/></StackPanel>
                                <StackPanel Classes="field"><TextBlock Text="Combat"/><NumericUpDown Value="{Binding CombatLevel}" Minimum="0" Maximum="10"/></StackPanel>
                                <StackPanel Classes="field"><TextBlock Text="Luck"/><NumericUpDown Value="{Binding LuckLevel}" Minimum="0" Maximum="10"/></StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Inventory">
                        <Grid ColumnDefinitions="220,*,240" Margin="0,10,0,0" DataContext="{Binding Inventory}" x:DataType="vm:InventoryTabViewModel">

                            <!-- Left: browsable/searchable item picker - drag onto a grid slot, or select + Add -->
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Text="Add item" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBox DockPanel.Dock="Top" Text="{Binding ItemSearchText}" Watermark="Search items..." Margin="0,0,0,6"/>
                                <Button DockPanel.Dock="Bottom" Content="Add to first empty slot" Command="{Binding AddSelectedItemCommand}"
                                        HorizontalAlignment="Stretch" Margin="0,6,0,0"/>
                                <TextBlock DockPanel.Dock="Bottom" Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Drag an item onto the grid, or select one and click Add. Only plain items/machines are fabricatable here - tools, rings, and similar can only be duplicated from ones you already carry."/>
                                <ListBox Name="PickerList" ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding SelectedPickerItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" PointerPressed="OnPickerItemPointerPressed">
                                                <Image Source="{Binding Converter={x:Static iconconv:PlaceableItemIconConverter.Instance}}"
                                                       Width="24" Height="24" Stretch="Uniform"/>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- Center: the grid itself, 12 columns x up to 3 rows, matching the real inventory menu -->
                            <DockPanel Grid.Column="1" Margin="16,0">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                                    <TextBlock Text="Backpack size" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding BackpackSizes}" SelectedItem="{Binding SelectedBackpackSize}" Width="180"/>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Foreground="#E57373" TextWrapping="Wrap" Margin="0,0,0,10"
                                           IsVisible="{Binding StatusMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                                <ItemsControl Name="InventoryGrid" ItemsSource="{Binding Slots}" DragDrop.AllowDrop="True">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="12" Rows="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InventorySlotViewModel">
                                            <Border Classes="invSlot" Classes.locked="{Binding IsLocked}" Classes.selected="{Binding IsSelected}"
                                                    PointerPressed="OnSlotPointerPressed">
                                                <Grid IsVisible="{Binding !IsLocked}">
                                                    <Image Source="{Binding Item, Converter={x:Static iconconv:InventoryItemIconConverter.Instance}}"
                                                           Width="32" Height="32" Stretch="Uniform"/>
                                                    <TextBlock Text="{Binding Item.Stack}" IsVisible="{Binding Item.IsStackable}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="11" Margin="0,0,2,1"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>

                            <!-- Right: properties for the selected slot -->
                            <ScrollViewer Grid.Column="2">
                                <StackPanel Spacing="8" IsVisible="{Binding SelectedSlot.Item, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                    <StackPanel Spacing="8" DataContext="{Binding SelectedSlot.Item}" x:DataType="vm:ItemRowViewModel">
                                        <TextBlock Text="Selected item" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ItemType}" Opacity="0.6" FontSize="11"/>
                                        <StackPanel Classes="field">
                                            <TextBlock Text="Stack"/>
                                            <NumericUpDown Value="{Binding Stack}" Minimum="1" Maximum="{Binding MaximumStackSize}" Width="140" FormatString="0" IsEnabled="{Binding IsStackable}"/>
                                        </StackPanel>
                                        <TextBlock Text="Not stackable - this item class only ever holds 1 per slot in the real game." Opacity="0.6" FontSize="11" TextWrapping="Wrap"
                                                   IsVisible="{Binding !IsStackable}"/>
                                        <StackPanel Classes="field" IsVisible="{Binding HasQuality}">
                                            <TextBlock Text="Quality"/>
                                            <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}" Width="140"/>
                                        </StackPanel>
                                        <Button Content="Remove from slot" Command="{Binding RemoveCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Stats">
                        <ScrollViewer DataContext="{Binding Stats}" x:DataType="vm:StatsTabViewModel">
                            <StackPanel Spacing="10" Margin="0,10,0,0">
                                <StackPanel Classes="field"><TextBlock Text="Days Played"/><NumericUpDown Value="{Binding DaysPlayed}" Minimum="0" Maximum="99999"/></StackPanel>
                                <StackPanel Classes="field"><TextBlock Text="Steps Taken"/><NumericUpDown Value="{Binding StepsTaken}" Minimum="0" Maximum="999999999"/></StackPanel>
                                <StackPanel Classes="field"><TextBlock Text="Monsters Killed"/><NumericUpDown Value="{Binding MonstersKilled}" Minimum="0" Maximum="999999"/></StackPanel>
                                <StackPanel Classes="field"><TextBlock Text="Items Shipped"/><NumericUpDown Value="{Binding ItemsShipped}" Minimum="0" Maximum="999999"/></StackPanel>
                                <StackPanel Classes="field"><TextBlock Text="Items Crafted"/><NumericUpDown Value="{Binding ItemsCrafted}" Minimum="0" Maximum="999999"/></StackPanel>
                                <StackPanel Classes="field"><TextBlock Text="Items Cooked"/><NumericUpDown Value="{Binding ItemsCooked}" Minimum="0" Maximum="999999"/></StackPanel>
                                <StackPanel Classes="field"><TextBlock Text="Quests Completed"/><NumericUpDown Value="{Binding QuestsCompleted}" Minimum="0" Maximum="999999"/></StackPanel>
                                <StackPanel Classes="field"><TextBlock Text="Times Fished"/><NumericUpDown Value="{Binding TimesFished}" Minimum="0" Maximum="999999"/></StackPanel>
                                <StackPanel Classes="field"><TextBlock Text="Truffles Found"/><NumericUpDown Value="{Binding TrufflesFound}" Minimum="0" Maximum="999999"/></StackPanel>
                                <StackPanel Classes="field"><TextBlock Text="Diamonds Found"/><NumericUpDown Value="{Binding DiamondsFound}" Minimum="0" Maximum="999999"/></StackPanel>
                                <StackPanel Classes="field"><TextBlock Text="Gold Found"/><NumericUpDown Value="{Binding GoldFound}" Minimum="0" Maximum="999999"/></StackPanel>
                                <StackPanel Classes="field"><TextBlock Text="Iridium Found"/><NumericUpDown Value="{Binding IridiumFound}" Minimum="0" Maximum="999999"/></StackPanel>
                                <StackPanel Classes="field"><TextBlock Text="Total Money Gifted"/><NumericUpDown Value="{Binding TotalMoneyGifted}" Minimum="0" Maximum="999999999"/></StackPanel>
                                <StackPanel Classes="field"><TextBlock Text="Lifetime Earnings"/><NumericUpDown Value="{Binding IndividualMoneyEarned}" Minimum="0" Maximum="999999999"/></StackPanel>

                                <TextBlock Text="All other stats" FontWeight="Bold" Margin="0,12,0,0"/>
                                <TextBlock Text="Every other real tracked stat (fishCaught, seedsSown, stoneGathered, ...) - not hand-picked, read directly from the save's own &lt;stats&gt; element."
                                           Opacity="0.6" FontSize="11" TextWrapping="Wrap" Width="500"/>
                                <ItemsControl ItemsSource="{Binding AllStats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StatRowViewModel">
                                            <StackPanel Classes="field">
                                                <TextBlock Text="{Binding Label}"/>
                                                <NumericUpDown Value="{Binding Value}" Minimum="0" Maximum="999999999"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Achievements">
                        <StackPanel Spacing="10" Margin="0,10,0,0" DataContext="{Binding Achievements}" x:DataType="vm:AchievementsTabViewModel">
                            <StackPanel Classes="field">
                                <TextBlock Text="Achievement"/>
                                <ComboBox ItemsSource="{Binding AvailableAchievements}" SelectedItem="{Binding SelectedNewAchievement}" Width="320"/>
                                <Button Content="Add" Command="{Binding AddCommand}"/>
                            </StackPanel>
                            <TextBlock Text="Unlocked" FontWeight="Bold"/>
                            <ListBox ItemsSource="{Binding Unlocked}" SelectedItem="{Binding SelectedUnlocked}" Height="220"/>
                            <Button Content="Remove Selected" Command="{Binding RemoveSelectedCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Recipes">
                        <Grid ColumnDefinitions="*,*" Margin="0,10,0,0" DataContext="{Binding Recipes}" x:DataType="vm:RecipesTabViewModel">
                            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto,Auto,*" ColumnDefinitions="*">
                                <TextBlock Grid.Row="0" Text="Crafting - not known" FontWeight="Bold"/>
                                <TextBox Grid.Row="1" Text="{Binding CraftingSearchText}" Watermark="Search..." Margin="0,4,0,4"/>
                                <ListBox Grid.Row="2" Name="AvailableCraftingList" ItemsSource="{Binding AvailableCrafting}"
                                         SelectionMode="Multiple" SelectedItems="{Binding SelectedAvailableCraftingItems}"
                                         DoubleTapped="OnAvailableCraftingDoubleTapped"/>
                                <TextBlock Grid.Row="3" Text="{Binding KnownCrafting.Count, StringFormat='Known ({0}) - double-click, or select (shift/ctrl/cmd-click, cmd-A for all) + Add/Remove'}"
                                           FontWeight="Bold" Margin="0,10,0,4" TextWrapping="Wrap"/>
                                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                    <Button Content="Add ->" Command="{Binding AddCraftingCommand}"/>
                                    <Button Content="&lt;- Remove" Command="{Binding RemoveCraftingCommand}"/>
                                </StackPanel>
                                <ListBox Grid.Row="5" ItemsSource="{Binding KnownCrafting}"
                                         SelectionMode="Multiple" SelectedItems="{Binding SelectedKnownCraftingItems}"
                                         DoubleTapped="OnKnownCraftingDoubleTapped"/>
                            </Grid>
                            <Grid Grid.Column="1" Margin="16,0,0,0" RowDefinitions="Auto,Auto,*,Auto,Auto,*" ColumnDefinitions="*">
                                <TextBlock Grid.Row="0" Text="Cooking - not known" FontWeight="Bold"/>
                                <TextBox Grid.Row="1" Text="{Binding CookingSearchText}" Watermark="Search..." Margin="0,4,0,4"/>
                                <ListBox Grid.Row="2" ItemsSource="{Binding AvailableCooking}"
                                         SelectionMode="Multiple" SelectedItems="{Binding SelectedAvailableCookingItems}"
                                         DoubleTapped="OnAvailableCookingDoubleTapped"/>
                                <TextBlock Grid.Row="3" Text="{Binding KnownCooking.Count, StringFormat='Known ({0}) - double-click, or select (shift/ctrl/cmd-click, cmd-A for all) + Add/Remove'}"
                                           FontWeight="Bold" Margin="0,10,0,4" TextWrapping="Wrap"/>
                                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                    <Button Content="Add ->" Command="{Binding AddCookingCommand}"/>
                                    <Button Content="&lt;- Remove" Command="{Binding RemoveCookingCommand}"/>
                                </StackPanel>
                                <ListBox Grid.Row="5" ItemsSource="{Binding KnownCooking}"
                                         SelectionMode="Multiple" SelectedItems="{Binding SelectedKnownCookingItems}"
                                         DoubleTapped="OnKnownCookingDoubleTapped"/>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Collections">
                        <TabControl Margin="0,10,0,0" DataContext="{Binding Collections}" x:DataType="vm:CollectionsTabViewModel">
                            <TabItem Header="Shipping">
                                <ContentControl Content="{Binding Shipping}" ContentTemplate="{StaticResource CollectionSectionTemplate}"/>
                            </TabItem>
                            <TabItem Header="Minerals">
                                <ContentControl Content="{Binding Minerals}" ContentTemplate="{StaticResource CollectionSectionTemplate}"/>
                            </TabItem>
                            <TabItem Header="Cooking">
                                <ContentControl Content="{Binding Cooking}" ContentTemplate="{StaticResource CollectionSectionTemplate}"/>
                            </TabItem>
                            <TabItem Header="Fish">
                                <ContentControl Content="{Binding Fish}" ContentTemplate="{StaticResource CollectionSectionTemplate}"/>
                            </TabItem>
                            <TabItem Header="Artifacts">
                                <ContentControl Content="{Binding Artifacts}" ContentTemplate="{StaticResource CollectionSectionTemplate}"/>
                            </TabItem>
                        </TabControl>
                    </TabItem>

                    <TabItem Header="Powers">
                        <ScrollViewer Margin="0,10,0,0" DataContext="{Binding Powers}" x:DataType="vm:PowersTabViewModel">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Covers what pre-1.6 saves called 'special items' (keys, guides, charms) plus Qi Walnut Room rewards (skill books, masteries). Book/Mastery rewards aren't editable yet - their real save format (a stats sub-dictionary) wasn't verifiable against any real example."
                                           TextWrapping="Wrap" Opacity="0.7" Width="600"/>
                                <ItemsControl ItemsSource="{Binding Powers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PowerRowViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                                <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsUnlocked}" IsEnabled="{Binding IsEditable}" Width="260"/>
                                                <TextBlock Text="{Binding KindLabel}" Opacity="0.5" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Quests">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,10,0,0" DataContext="{Binding Quests}" x:DataType="vm:QuestsTabViewModel">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="Complete a quest" FontWeight="Bold"/>
                                <TextBlock Text="Every quest in the game, not just ones currently offered - completing one from here either updates it if it's already in your log, or adds it already completed if not."
                                           TextWrapping="Wrap" Opacity="0.7" FontSize="11" Width="420"/>
                                <ContentControl Content="{Binding Roster}" ContentTemplate="{StaticResource CollectionSectionTemplate}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="10" Margin="16,0,0,0">
                                <TextBlock Text="Active log" FontWeight="Bold"/>
                                <TextBlock Text="Quests currently in your log - accept/complete or dismiss them individually."
                                           TextWrapping="Wrap" Opacity="0.7" FontSize="11"/>
                                <ScrollViewer>
                                    <ItemsControl ItemsSource="{Binding Quests}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:QuestRowViewModel">
                                                <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="0,8">
                                                    <StackPanel Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding Id, StringFormat='(id {0})'}" Opacity="0.5" FontSize="11" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.7" FontSize="12" Width="500"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                                            <CheckBox Content="Accepted" IsChecked="{Binding Accepted}"/>
                                                            <CheckBox Content="Completed" IsChecked="{Binding Completed}"/>
                                                            <Button Content="Remove" Command="{Binding RemoveCommand}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Relationships">
                        <Grid ColumnDefinitions="200,*" Margin="0,10,0,0" DataContext="{Binding Relationships}" x:DataType="vm:RelationshipsTabViewModel">
                            <ListBox Grid.Column="0" ItemsSource="{Binding NpcNames}" SelectedItem="{Binding SelectedNpcName}"/>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="10" IsEnabled="{Binding HasSelection}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding SelectedNpcName}" FontWeight="Bold"/>
                                    <TextBlock Text="(not yet met - editing will create their relationship)" Opacity="0.6" FontSize="11" VerticalAlignment="Center"
                                               IsVisible="{Binding !IsMet}"/>
                                    <TextBlock Text="(romanceable)" Opacity="0.6" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding CanBeRomanced}"/>
                                </StackPanel>
                                <StackPanel Classes="field">
                                    <TextBlock Text="Points"/>
                                    <NumericUpDown Value="{Binding Points}" Minimum="0" Maximum="3000"/>
                                </StackPanel>
                                <StackPanel Classes="field">
                                    <TextBlock Text="Status"/>
                                    <ComboBox ItemsSource="{Binding FriendshipStatuses}" SelectedItem="{Binding SelectedStatus}" Width="180"/>
                                </StackPanel>
                                <StackPanel Classes="field">
                                    <TextBlock Text="Gifts this week"/>
                                    <NumericUpDown Value="{Binding GiftsThisWeek}" Minimum="0" Maximum="2"/>
                                </StackPanel>
                                <StackPanel Classes="field">
                                    <TextBlock Text="Gifts today"/>
                                    <NumericUpDown Value="{Binding GiftsToday}" Minimum="0" Maximum="1"/>
                                </StackPanel>
                                <CheckBox Content="Talked to today" IsChecked="{Binding TalkedToToday}"/>
                                <CheckBox Content="Proposal rejected" IsChecked="{Binding ProposalRejected}"/>
                                <CheckBox Content="Roommate marriage" IsChecked="{Binding RoommateMarriage}" IsVisible="{Binding !CanBeRomanced}"/>
                                <TextBlock Text="Every villager is listed, met or not - setting any field for someone you haven't met yet creates their relationship from zero."
                                           TextWrapping="Wrap" Opacity="0.7" Width="300"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Storage">
                        <Grid ColumnDefinitions="220,*,240" Margin="0,10,0,0" DataContext="{Binding Storage}" x:DataType="vm:StorageTabViewModel">
                            <ListBox Grid.Column="0" ItemsSource="{Binding Chests}" SelectedItem="{Binding SelectedChest}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChestRowViewModel">
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <DockPanel Grid.Column="1" Margin="16,0,0,0" IsEnabled="{Binding SelectedChest, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                <TextBlock DockPanel.Dock="Top" Text="Select a chest on the left." Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8"
                                           IsVisible="{Binding SelectedChest, Converter={x:Static conv:ObjectConverters.IsNull}}"/>
                                <TextBlock DockPanel.Dock="Top" Text="This chest is empty - add something from the right." Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8"
                                           IsVisible="{Binding ChestIsEmpty}"/>
                                <ItemsControl ItemsSource="{Binding SelectedChestItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ItemRowViewModel">
                                            <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="0,4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding ItemType}" Width="90"/>
                                                    <TextBlock Text="{Binding Name}" Width="120"/>
                                                    <TextBlock Text="Stack" VerticalAlignment="Center"/>
                                                    <NumericUpDown Value="{Binding Stack}" Minimum="1" Maximum="{Binding MaximumStackSize}" Width="110" FormatString="0" IsEnabled="{Binding IsStackable}"/>
                                                    <TextBlock Text="Quality" VerticalAlignment="Center" IsVisible="{Binding HasQuality}"/>
                                                    <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}" Width="110" IsVisible="{Binding HasQuality}"/>
                                                    <Button Content="Remove" Command="{Binding RemoveCommand}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>

                            <StackPanel Grid.Column="2" Margin="16,0,0,0" Spacing="6" IsEnabled="{Binding SelectedChest, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                <TextBlock Text="Add item to chest" FontWeight="Bold"/>
                                <TextBox Text="{Binding ItemSearchText}" Watermark="Search items..."/>
                                <ListBox ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding SelectedNewItem}" Height="400">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Image Source="{Binding Converter={x:Static iconconv:PlaceableItemIconConverter.Instance}}"
                                                       Width="20" Height="20" Stretch="Uniform"/>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="Add" Command="{Binding AddItemCommand}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Farm">
                        <StackPanel Spacing="10" Margin="0,10,0,0" DataContext="{Binding Farm}" x:DataType="vm:FarmTabViewModel">
                            <StackPanel Classes="field">
                                <TextBlock Text="Farm Type"/>
                                <ComboBox ItemsSource="{Binding FarmTypes}" SelectedItem="{Binding SelectedFarmType}" Width="180"/>
                            </StackPanel>
                            <StackPanel Classes="field">
                                <TextBlock Text="Weather Tomorrow"/>
                                <TextBox Text="{Binding WeatherForTomorrow}" Width="180"/>
                            </StackPanel>
                            <TextBlock Text="A real weather condition id (confirmed: Sun, Rain, Wedding) - free text since the full real id list isn't confirmed, rather than restrict to a guessed dropdown."
                                       Opacity="0.7" TextWrapping="Wrap" Width="400"/>
                            <StackPanel Classes="field">
                                <TextBlock Text="Daily Luck"/>
                                <NumericUpDown Value="{Binding DailyLuck}" Minimum="-1" Maximum="1" Increment="0.01" FormatString="0.00"/>
                            </StackPanel>
                            <TextBlock Text="Buildings" FontWeight="Bold" Margin="0,12,0,0"/>
                            <ItemsControl ItemsSource="{Binding BuildingTypes}"/>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Map">
                        <Grid ColumnDefinitions="*,260" Margin="0,10,0,0" DataContext="{Binding Map}" x:DataType="vm:MapTabViewModel">
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"/>
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,12,4">
                                        <TextBlock Text="Location" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding AvailableLocations}" SelectedItem="{Binding SelectedLocationName}" Width="140"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                        <TextBlock Text="Assets folder" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding ContentFolder}" Width="200"/>
                                        <Button Content="Browse..." Click="OnBrowseMapFolderClicked"/>
                                        <Button Content="Auto-Extract" Command="{Binding AutoExtractCommand}" IsEnabled="{Binding !IsExtracting}"/>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding ExtractStatus}" Opacity="0.7" Margin="0,0,0,6"
                                           IsVisible="{Binding ExtractStatus, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <ToggleButton Content="Select" IsChecked="{Binding IsSelectToolActive}" Margin="0,0,4,4"/>
                                    <ToggleButton Content="Object" IsChecked="{Binding IsObjectToolActive}" Margin="0,0,4,4"/>
                                    <ToggleButton Content="Building" IsChecked="{Binding IsBuildingToolActive}" Margin="0,0,4,4"/>
                                    <ToggleButton Content="Till" IsChecked="{Binding IsTillToolActive}" Margin="0,0,4,4"/>
                                    <ToggleButton Content="Plant Crop" IsChecked="{Binding IsPlantCropToolActive}" Margin="0,0,4,4"/>
                                    <ToggleButton Content="Plant Tree" IsChecked="{Binding IsPlantTreeToolActive}" Margin="0,0,4,4"/>
                                    <ToggleButton Content="Plant Bush" IsChecked="{Binding IsPlantBushToolActive}" Margin="0,0,4,4"/>
                                    <TextBlock Text="{Binding BrushSize, StringFormat='Brush: {0}x{0} ([ / ] to resize)'}" VerticalAlignment="Center"
                                               Opacity="0.7" FontSize="11" Margin="8,0,0,4" IsVisible="{Binding IsAnyToolActive}"/>
                                </WrapPanel>
                                <TextBlock DockPanel.Dock="Bottom" Opacity="0.6" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="{Binding #FarmMap.Status}"/>
                                <TextBlock DockPanel.Dock="Bottom" Opacity="0.5" FontSize="11" TextWrapping="Wrap"
                                           Text="Scroll to pan, Ctrl/Cmd+scroll to zoom, hold Space and drag to pan. Drag an entity to move it; drag empty ground to range-select. [ / ] resizes the draw brush."/>
                                <controls:FarmMapControl x:Name="FarmMap" Entities="{Binding Entities}" Selected="{Binding Selected}"
                                                          Season="{Binding Season}" ContentFolder="{Binding ContentFolder}"
                                                          LocationName="{Binding SelectedLocationName}"
                                                          HouseUpgradeLevel="{Binding HouseUpgradeLevel}"
                                                          ClickedTile="{Binding ClickedTile}"
                                                          SelectedRange="{Binding SelectedRange}"
                                                          IsPlacementToolActive="{Binding IsAnyToolActive}"
                                                          MoveRequest="{Binding MoveRequest}"
                                                          BrushSize="{Binding BrushSize}"
                                                          HoverFootprintWidth="{Binding HoverFootprintWidth}"
                                                          HoverFootprintHeight="{Binding HoverFootprintHeight}"
                                                          CurrentDaysPlayed="{Binding CurrentDaysPlayed}"
                                                          MinHeight="400"/>
                            </DockPanel>

                            <ScrollViewer Grid.Column="1" Margin="16,0,0,0">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="6" IsVisible="{Binding HasSelectedRange}">
                                        <TextBlock Text="{Binding SelectedRange.Count, StringFormat='Range selection ({0})'}" FontWeight="Bold"/>
                                        <TextBlock Text="Click and drag on the map to select an area." Opacity="0.7" TextWrapping="Wrap" FontSize="11"/>
                                        <Button Content="{Binding SelectedRange.Count, StringFormat='Collect Selected ({0})'}" Command="{Binding CollectRangeCommand}"/>
                                        <TextBlock Text="Removes each entity and adds its real yield (wood, ore, harvested crop, ...) to your inventory where one exists."
                                                   Opacity="0.6" TextWrapping="Wrap" FontSize="11"/>
                                        <Button Content="{Binding SelectedRange.Count, StringFormat='Remove Selected ({0})'}" Command="{Binding RemoveRangeCommand}"/>
                                    </StackPanel>

                                    <TextBlock Text="Tool properties" FontWeight="Bold" IsVisible="{Binding IsAnyToolActive}"/>
                                    <TextBlock Text="{Binding ClickedTile, StringFormat='Last click: {0}', TargetNullValue='Click the map to use the active tool'}"
                                               Opacity="0.7" TextWrapping="Wrap" IsVisible="{Binding IsAnyToolActive}"/>

                                    <StackPanel Spacing="6" IsVisible="{Binding IsObjectToolActive}">
                                        <AutoCompleteBox ItemsSource="{Binding AvailablePlaceableItems}" SelectedItem="{Binding SelectedPlaceableItem}"
                                                          FilterMode="Contains" Watermark="Search items...">
                                            <AutoCompleteBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Image Source="{Binding Converter={x:Static iconconv:PlaceableItemIconConverter.Instance}}"
                                                               Width="20" Height="20" Stretch="Uniform"/>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </AutoCompleteBox.ItemTemplate>
                                        </AutoCompleteBox>
                                        <TextBlock Text="Only plain objects (debris, produce, forage, etc.) can be placed so far - trees and animals have their own tools."
                                                   Opacity="0.6" TextWrapping="Wrap" FontSize="11"/>
                                        <TextBlock Text="Click the map to drop the selected item. If the tile is occupied you'll be asked to confirm clearing it first."
                                                   Opacity="0.6" TextWrapping="Wrap" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Spacing="6" IsVisible="{Binding IsBuildingToolActive}">
                                        <ComboBox ItemsSource="{Binding AvailablePlaceableBuildings}" SelectedItem="{Binding SelectedPlaceableBuilding}" HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Image Source="{Binding Converter={x:Static iconconv:PlaceableBuildingIconConverter.Instance}}"
                                                               Width="20" Height="20" Stretch="Uniform"/>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="Only buildings with no interior (Gold Clock, Obelisks, Well, Silo, Mill, Fish Pond, Pet Bowl, Stable, Shipping Bin, Junimo Hut) - Barn/Coop/etc. need their interior location verified first."
                                                   Opacity="0.6" TextWrapping="Wrap" FontSize="11"/>
                                        <TextBlock Text="Click the map to drop the selected building. If the footprint is occupied you'll be asked to confirm clearing it first."
                                                   Opacity="0.6" TextWrapping="Wrap" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Spacing="6" IsVisible="{Binding IsTillToolActive}">
                                        <TextBlock Text="Click the map to till a tile (dry, unfertilized). Already-tilled ground is left alone - no confirmation needed."
                                                   Opacity="0.7" TextWrapping="Wrap" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Spacing="6" IsVisible="{Binding IsPlantCropToolActive}">
                                        <AutoCompleteBox ItemsSource="{Binding AvailablePlaceableCrops}" SelectedItem="{Binding SelectedPlaceableCrop}"
                                                          FilterMode="Contains" Watermark="Search seeds..."/>
                                        <CheckBox Content="Plant already matured (harvest-ready)" IsChecked="{Binding PlantCropMature}"/>
                                        <TextBlock Text="Click the map to till (if needed) and plant. Planting into already-bare tilled soil needs no confirmation; anything else in the way does."
                                                   Opacity="0.6" TextWrapping="Wrap" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Spacing="6" IsVisible="{Binding IsPlantTreeToolActive}">
                                        <StackPanel Classes="field"><TextBlock Text="Species"/><ComboBox ItemsSource="{Binding AvailableTreeTypes}" SelectedItem="{Binding SelectedTreeType}" Width="180"/></StackPanel>
                                        <StackPanel Classes="field"><TextBlock Text="Growth stage"/><NumericUpDown Value="{Binding PlantTreeGrowthStage}" Minimum="0" Maximum="5" Width="180"/></StackPanel>
                                        <TextBlock Text="Defaults to fully grown (5) - lower it to plant a sapling instead. Click the map to plant."
                                                   Opacity="0.6" TextWrapping="Wrap" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Spacing="6" IsVisible="{Binding IsPlantBushToolActive}">
                                        <StackPanel Classes="field"><TextBlock Text="Size"/><ComboBox ItemsSource="{Binding AvailableBushSizes}" SelectedItem="{Binding SelectedBushSize}" Width="180"/></StackPanel>
                                        <CheckBox Content="Plant already matured (bloom-ready)" IsChecked="{Binding PlantBushMature}"/>
                                        <TextBlock Text="Medium/large bushes span 2-3 tiles starting at the clicked tile, not centered on it. Click the map to plant."
                                                   Opacity="0.6" TextWrapping="Wrap" FontSize="11"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding PlacementBlockedMessage}" Foreground="#E57373" TextWrapping="Wrap" FontSize="11"
                                               Margin="0,6,0,0" IsVisible="{Binding PlacementBlockedMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>

                                    <StackPanel Spacing="6" IsVisible="{Binding PendingPlacement, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                                Margin="0,10,0,0">
                                        <TextBlock Text="{Binding PendingPlacement.Label, StringFormat='Confirm: {0}'}" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock Text="This will clear the following before placing:" Opacity="0.7" TextWrapping="Wrap" FontSize="11"/>
                                        <ItemsControl ItemsSource="{Binding PendingPlacement.Blocking}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="11" Opacity="0.85"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="Confirm" Command="{Binding ConfirmPendingPlacementCommand}"/>
                                            <Button Content="Cancel" Command="{Binding CancelPendingPlacementCommand}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="Selected entity" FontWeight="Bold" Margin="0,10,0,0" IsVisible="{Binding Selected, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
                                    <TextBlock Text="{Binding Selected.Label}" TextWrapping="Wrap" IsVisible="{Binding Selected, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
                                    <TextBlock Text="{Binding Selected.Position, StringFormat='Tile: {0}'}" IsVisible="{Binding Selected, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>

                                    <ContentControl Content="{Binding SelectedDetails}">
                                        <ContentControl.DataTemplates>

                                            <DataTemplate DataType="vm:TreeDetailsViewModel">
                                                <StackPanel Spacing="6">
                                                    <StackPanel Classes="field"><TextBlock Text="Species"/><ComboBox ItemsSource="{Binding TreeTypes}" SelectedItem="{Binding SelectedTreeType}" Width="180"/></StackPanel>
                                                    <StackPanel Classes="field"><TextBlock Text="Growth stage"/><NumericUpDown Value="{Binding GrowthStage}" Minimum="0" Maximum="5" Width="180"/></StackPanel>
                                                    <StackPanel Classes="field"><TextBlock Text="Health"/><NumericUpDown Value="{Binding Health}" Minimum="0" Maximum="10" Width="180"/></StackPanel>
                                                    <CheckBox Content="Stump" IsChecked="{Binding Stump}"/>
                                                    <CheckBox Content="Tapped" IsChecked="{Binding Tapped}"/>
                                                    <CheckBox Content="Flipped" IsChecked="{Binding Flipped}"/>
                                                    <CheckBox Content="Has seed" IsChecked="{Binding HasSeed}"/>
                                                    <CheckBox Content="Fertilized" IsChecked="{Binding Fertilized}"/>
                                                    <CheckBox Content="Shake left" IsChecked="{Binding ShakeLeft}"/>
                                                    <CheckBox Content="Has moss" IsChecked="{Binding HasMoss}"/>
                                                    <CheckBox Content="Shaken today" IsChecked="{Binding WasShakenToday}"/>
                                                    <TextBlock Text="Species names are best-effort, not verified against real save data (see README)."
                                                               Opacity="0.7" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>

                                            <DataTemplate DataType="vm:GrassDetailsViewModel">
                                                <StackPanel Spacing="6">
                                                    <StackPanel Classes="field"><TextBlock Text="Type"/><ComboBox ItemsSource="{Binding GrassTypes}" SelectedItem="{Binding SelectedGrassType}" Width="180"/></StackPanel>
                                                    <StackPanel Classes="field"><TextBlock Text="Weeds"/><NumericUpDown Value="{Binding NumberOfWeeds}" Minimum="0" Maximum="4" Width="180"/></StackPanel>
                                                </StackPanel>
                                            </DataTemplate>

                                            <DataTemplate DataType="vm:HoeDirtDetailsViewModel">
                                                <StackPanel Spacing="6">
                                                    <StackPanel Classes="field"><TextBlock Text="State"/><ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}" Width="180"/></StackPanel>
                                                    <CheckBox Content="Greenhouse dirt" IsChecked="{Binding IsGreenhouseDirt}"/>

                                                    <ContentControl Content="{Binding Crop}" IsVisible="{Binding Crop, Converter={x:Static conv:ObjectConverters.IsNotNull}}" Margin="0,8,0,0">
                                                        <ContentControl.DataTemplates>
                                                            <DataTemplate DataType="vm:CropDetailsViewModel">
                                                                <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                                                    <StackPanel Spacing="6">
                                                                        <TextBlock Text="Crop" FontWeight="Bold"/>
                                                                        <StackPanel Classes="field"><TextBlock Text="Growth phase"/><NumericUpDown Value="{Binding CurrentPhase}" Minimum="0" Maximum="6" Width="180"/></StackPanel>
                                                                        <StackPanel Classes="field"><TextBlock Text="Day of phase"/><NumericUpDown Value="{Binding DayOfCurrentPhase}" Minimum="0" Maximum="99" Width="180"/></StackPanel>
                                                                        <StackPanel Classes="field"><TextBlock Text="Min harvest"/><NumericUpDown Value="{Binding MinHarvest}" Minimum="0" Maximum="10" Width="180"/></StackPanel>
                                                                        <StackPanel Classes="field"><TextBlock Text="Max harvest"/><NumericUpDown Value="{Binding MaxHarvest}" Minimum="0" Maximum="10" Width="180"/></StackPanel>
                                                                        <StackPanel Classes="field"><TextBlock Text="Regrow after"/><NumericUpDown Value="{Binding RegrowAfterHarvest}" Minimum="-1" Maximum="99" Width="180"/></StackPanel>
                                                                        <CheckBox Content="Fully grown" IsChecked="{Binding FullGrown}"/>
                                                                        <CheckBox Content="Dead" IsChecked="{Binding Dead}"/>
                                                                        <CheckBox Content="Flip" IsChecked="{Binding Flip}"/>
                                                                        <TextBlock Text="{Binding SeedIndex, StringFormat='Seed item id: {0} (read-only)'}" Opacity="0.7"/>
                                                                        <TextBlock Text="{Binding IndexOfHarvest, StringFormat='Harvest item id: {0} (read-only)'}" Opacity="0.7"/>
                                                                        <Button Content="Remove crop (keep tilled soil)" Command="{Binding RemoveCropCommand}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ContentControl.DataTemplates>
                                                    </ContentControl>
                                                </StackPanel>
                                            </DataTemplate>

                                            <DataTemplate DataType="vm:ResourceClumpDetailsViewModel">
                                                <StackPanel Spacing="6">
                                                    <StackPanel Classes="field"><TextBlock Text="Sprite index"/><NumericUpDown Value="{Binding ParentSheetIndex}" Minimum="0" Maximum="999" Width="180"/></StackPanel>
                                                    <StackPanel Classes="field"><TextBlock Text="Health"/><NumericUpDown Value="{Binding Health}" Minimum="0" Maximum="99" Width="180"/></StackPanel>
                                                </StackPanel>
                                            </DataTemplate>

                                            <DataTemplate DataType="vm:PlacedObjectDetailsViewModel">
                                                <StackPanel Spacing="6" DataContext="{Binding Item}">
                                                    <StackPanel Classes="field"><TextBlock Text="Stack"/><NumericUpDown Value="{Binding Stack}" Minimum="1" Maximum="{Binding MaximumStackSize}" Width="180" IsEnabled="{Binding IsStackable}"/></StackPanel>
                                                    <StackPanel Classes="field" IsVisible="{Binding HasQuality}"><TextBlock Text="Quality"/><ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}" Width="180"/></StackPanel>
                                                </StackPanel>
                                            </DataTemplate>

                                            <DataTemplate DataType="vm:BuildingDetailsViewModel">
                                                <StackPanel Spacing="6">
                                                    <StackPanel Classes="field" IsVisible="{Binding HasSkins}">
                                                        <TextBlock Text="Skin"/>
                                                        <ComboBox ItemsSource="{Binding AvailableSkins}" SelectedItem="{Binding SelectedSkin}" Width="180"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Most other building fields aren't verified against real save data yet (see README) - not safely editable here."
                                                               Opacity="0.7" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>

                                            <DataTemplate DataType="vm:BushDetailsViewModel">
                                                <StackPanel Spacing="6">
                                                    <StackPanel Classes="field"><TextBlock Text="Size"/><ComboBox ItemsSource="{Binding BushSizes}" SelectedItem="{Binding SelectedSize}" Width="180"/></StackPanel>
                                                    <StackPanel Classes="field"><TextBlock Text="Health"/><NumericUpDown Value="{Binding Health}" Minimum="0" Maximum="99" Width="180"/></StackPanel>
                                                    <CheckBox Content="Bloom/harvest ready" IsChecked="{Binding BloomReady}"/>
                                                    <CheckBox Content="Flipped" IsChecked="{Binding Flipped}"/>
                                                    <CheckBox Content="Town bush (decorative)" IsChecked="{Binding TownBush}"/>
                                                    <CheckBox Content="Greenhouse/sheltered" IsChecked="{Binding GreenhouseBush}"/>
                                                    <CheckBox Content="Draw shadow" IsChecked="{Binding DrawShadow}"/>
                                                </StackPanel>
                                            </DataTemplate>

                                        </ContentControl.DataTemplates>
                                    </ContentControl>

                                    <Button Content="Remove" Command="{Binding SelectedDetails.RemoveCommand}" IsVisible="{Binding Selected, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>

                                    <TextBlock Text="Tile info" FontWeight="Bold" Margin="0,10,0,0"
                                               IsVisible="{Binding #FarmMap.SelectedTileInfo, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding #FarmMap.SelectedTileInfo}" TextWrapping="Wrap" FontFamily="monospace" FontSize="11"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                </TabControl>
            </DockPanel>
        </TabItem>

        <TabItem Header="Trainer">
            <DockPanel Margin="16" DataContext="{Binding Trainer}" x:DataType="vm:TrainerViewModel">
                <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Margin="0,0,0,12" Opacity="0.7"/>

                <StackPanel IsEnabled="{Binding IsConnected}" Spacing="10">
                    <TextBlock Text="{Binding PlayerName, StringFormat='Playing as {0}'}" FontWeight="Bold"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Money" Width="90" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding Money}" Minimum="0" Maximum="999999999" Width="160" FormatString="0"/>
                        <Button Content="Set" Command="{Binding ApplyMoneyCommand}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Health" Width="90" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding Health}" Minimum="0" Maximum="9999" Width="160" FormatString="0"/>
                        <Button Content="Set" Command="{Binding ApplyHealthCommand}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Max Health" Width="90" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding MaxHealth}" Minimum="0" Maximum="9999" Width="160" FormatString="0"/>
                        <Button Content="Set" Command="{Binding ApplyMaxHealthCommand}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Stamina" Width="90" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding Stamina}" Minimum="0" Maximum="9999" Width="160" FormatString="0"/>
                        <Button Content="Set" Command="{Binding ApplyStaminaCommand}"/>
                    </StackPanel>

                    <CheckBox Content="Infinite stamina" IsChecked="{Binding InfiniteStamina}"/>
                    <CheckBox Content="Infinite health" IsChecked="{Binding InfiniteHealth}"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Speed bonus" Width="90" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding SpeedBonus}" Minimum="0" Maximum="10" Width="160" FormatString="0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </TabItem>
    </TabControl>

</Window>
